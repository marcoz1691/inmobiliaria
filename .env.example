# Copia a .env.local. Sin DATABASE_URL se usa PGlite local (.data/pglite).
APP_URL=http://localhost:3000
DEFAULT_TENANT_SLUG=piloto

# Supabase (Postgres vía pooler en modo transacción + Storage)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media
# Bucket privado (sin acceso público) para los PDF originales importados. Debe ser distinto de SUPABASE_STORAGE_BUCKET.
SUPABASE_PRIVATE_BUCKET=private

# openssl rand -base64 32
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=

# Seed: cuenta inicial del agente (si falta la contraseña se genera una y se muestra una vez)
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# IA (chatbot e importación asistida)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Meta: WhatsApp Cloud API, webhooks, Conversions API, Messenger/Instagram
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0
META_PIXEL_ID=
META_CAPI_TOKEN=
META_PAGE_TOKEN=

# Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel Cron
CRON_SECRET=
